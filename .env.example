# Salin jadi .env lalu sesuaikan.
# Generate SESSION_SECRET baru: openssl rand -hex 32

# SQLite untuk development (file relatif terhadap folder prisma/).
# Produksi: ganti provider ke "postgresql" di schema.prisma + isi DATABASE_URL Postgres.
DATABASE_URL="file:./dev.db"

# Kunci tanda tangan cookie sesi. WAJIB diganti di produksi.
SESSION_SECRET=""
